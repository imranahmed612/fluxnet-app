{
  "name": "fluxnet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:browser-handoff": "node --test tests/browserHandoff.test.mjs",
    "test:extension": "node --test browser-extension/tests/media.test.mjs",
