{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxNet",
  "version": "0.1.0",
  "identifier": "com.administrator.fluxnet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FluxNet",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Imran",
    "targets": ["nsis"],
    "resources": {
      "../browser-extension/install-native-host.ps1": "install-native-host.ps1",
      "../browser-extension/uninstall-native-host.ps1": "uninstall-native-host.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QThDNTQ4NEJFMjQyMjQKUldRa1F1SkxTTVdvOTREV2ZCWlFIZ2Q4ZjJmb3BQL0Y3VEZPbTdiTGRvdE5hOW80eEhsRmhmZVoK",
      "endpoints": [],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
